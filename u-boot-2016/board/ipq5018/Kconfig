config H3C_UBI_ATTACH_READONLY
    bool
    default y if TARGET_IPQ5018_H3C_HW_D
    # a RAM trial must not let UBI attach rewrite the volume table
    default y if RAM_TRIAL_BUILD
    help
      Diagnostic and boot UBI attaches must not schedule writes.

config H3C_FDT_NOR_GUARD
    bool
    default y if TARGET_IPQ5018_H3C_HW_D
    help
      Drop the SPI-NOR node handed to Linux when the unit has none.

config H3C_OEM_FIT_HANDOFF
    bool
    default y if TARGET_IPQ5018_H3C_HW_D
    help
      Boot only a checked OEM FIT, and record that for the FDT fixups.

config H3C_FIT_ROOTFS_BOOTARGS
    bool
    default y if TARGET_IPQ5018_H3C_HW_C || TARGET_IPQ5018_H3C_HW_D
    help
      Derive the rootfs bootargs from the FIT being booted.

config H3C_BOOTCONFIG_RETAINED_FAILURE
    bool
    default y if TARGET_IPQ5018_H3C_HW_D
    help
      Keep and export the pinned preimages of a failed BOOTCONFIG transaction.

config SLOT_BACKEND_SINGLE
    bool "The device has one system slot"
    help
      The boot chain records no second system, so slot queries answer
      "slot 0" without reading BOOTCONFIG. Leave unset for BOOTCONFIG
      dual-slot devices.

config SLOT_BACKEND_XIAOMI
    bool "Xiaomi environment flags select the system slot"
    depends on !SLOT_BACKEND_SINGLE && !H3C_IPQ5018_COMMON
    default y if TARGET_IPQ5018_XIAOMI_CR8806
    help
      Stock miwifi firmware keeps BOOTCONFIG at slot 0 and lets U-Boot
      choose rootfs or rootfs_1 from flag_* variables in the environment,
      which Linux updates with nvram. Boot the slot those flags select
      and record it the way the stock bootmiwifi command does.

config XIAOMI_FW_MODEL_ID
    int "Model id the Xiaomi official .bin must carry (0 = accept any)"
    depends on SLOT_BACKEND_XIAOMI
    default 51 if TARGET_IPQ5018_XIAOMI_CR8806
    default 0
    help
      The HDR1 header of an official package holds a model id (CR8806 is
      51, RA81 is 44). The rescue page refuses a package for another model.

config ENV_SIZE_64K
    bool
    default y if SLOT_BACKEND_XIAOMI
    help
      Stock Xiaomi firmware keeps a single 64 KiB environment (CRC32 then
      data) that Linux edits with nvram. Reading it as 256 KiB gives a bad
      CRC, and saving 256 KiB would break it for Linux.

endif
