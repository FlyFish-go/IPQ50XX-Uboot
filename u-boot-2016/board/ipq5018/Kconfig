config H3C_METADATA_IMPLICIT_TARGET
    bool
    default y if TARGET_IPQ5018_H3C_RT3000_B
    help
      Metadata uploads without a target use the single-target writer.

config H3C_FLASHRW_NAMED_NAND
    bool
    default y if TARGET_IPQ5018_H3C_RT3000_B
    help
      flash <partition> on NAND goes through the validated named-partition writer.

config LED_STATUS_AT_GPIO_INIT
    bool
    default y if TARGET_IPQ5018_H3C_RT3000_B || !H3C_IPQ5018_COMMON
    help
      Clear inherited LED colours and light the status LED (system_led)
      right after GPIO init. Without it the DTS leaves every LED off and
      the board stays dark until Linux sets its LEDs, 10-20 s after
      power-on.

config H3C_BOOTCONFIG_STAGE0_POLICY
    bool
    default y if TARGET_IPQ5018_H3C_HW_A || TARGET_IPQ5018_H3C_HW_C || TARGET_IPQ5018_H3C_RT3000_B
    help
      BOOTCONFIG is read with backup fallback and never rewritten by the generic code.

config H3C_BOOTCONFIG_WINDOW_READ
    bool
    default y if TARGET_IPQ5018_H3C_HW_D
