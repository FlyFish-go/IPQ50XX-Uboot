config ETHADDR_ASCII
    bool "Fall back to a text base MAC in a vendor NAND partition"
    default n
    help
	  When ART has no valid MAC, read "xx:xx:xx:xx:xx:xx" from
	  ETHADDR_ASCII_PART and give interface N the base MAC plus N.

config ETHADDR_ASCII_PART
    string "SMEM partition holding the base MAC text"
    depends on ETHADDR_ASCII
    default "factory"

config ETHADDR_ASCII_OFFSET
    hex "Offset of the MAC text in ETHADDR_ASCII_PART"
    depends on ETHADDR_ASCII
    default 0x0

config FAILSAFE_LAN_FIRST
    bool
    default y if H3C_IPQ5018_COMMON || TARGET_IPQ5018_HW3000B1 || \
		 TARGET_IPQ5018_LINGYAN_LYW_30M || TARGET_IPQ5018_CMCC_MR3000D_CI || \
		 TARGET_IPQ5018_CMCC_RAX3000Q || TARGET_IPQ5018_CMCC_PZ_L8
    help
	  The web failsafe page starts on eth1 (LAN switch) and falls back
	  to eth0 (WAN GE PHY) after a grace period.

config QPIC_NAND_ECC_PROBE
    bool "Detect the serial NAND ECC strength from the boot chain"
    depends on QPIC_SERIAL && !H3C_IPQ5018_COMMON
    default y
    help
	  The BCH strength (4 or 8 bit) is chosen by the vendor, not by the
	  chip: the same part is formatted differently on different boards
	  and vendor ID tables disagree. At NAND init, SBL1, the MIBIB and
	  both APPSBL copies are read in each format the spare area can hold
	  and the one that yields valid images is used. With no evidence the
	  QCA SBL1 default applies (ECC8 for 128-byte spare, else ECC4); with
	  contradicting evidence or read errors NAND writes are refused.
	  H3C boards keep their own source-bound catalog instead.

config QPIC_NAND_ECC_BITS
    int "Force the serial NAND ECC strength (0 = detect / ID table)"
    default 0
    help
	  Debug override: use this BCH strength for every chip and skip
	  QPIC_NAND_ECC_PROBE. 0 detects it (or uses the ID table when the
	  probe is disabled).
config H3C_RELEASE_SYSTEM_DEFAULT
    bool "H3C release: selected system by default, RESET recovery"
    depends on H3C_IPQ5018_COMMON
    default n
    help
      Explicit release-only power-on policy. Ignore imported bootcmd and boot
      the audited BOOTCONFIG-selected system through bootipq. RESET or an
      unconfirmed format enters eth1 recovery at 192.168.10.1 without saving
      ENV. This overrides the legacy default-web flag, not RAM/NOR rescue.
      It neither qualifies APPSBL installation nor enables NAND writes.

config H3C_DEFAULT_WEB
    bool "Enter the common recovery web UI at power-on"
    depends on H3C_IPQ5018_COMMON
    default n
    help
      Keep power-on at the common web UI while preserving the selected
      default system for explicit boot. Does not save environment variables.

config H3C_RAM_RESCUE
    bool "RAM-run rescue image loaded by an installed U-Boot"
    depends on H3C_RELEASE_SYSTEM_DEFAULT
    default n
    help
      Link at 0x49A20000 so an installed U-Boot at 0x4A920000 can load this
      ELF from its rescue page and start it with bootelf. Power-on always
      enters the rescue page. Writes keep the normal checks; the build
      identity is unchanged, so the matching flash build can be installed.

config H3C_NAND_PROFILE_ID
    string "Source-bound OEM NAND profile ID"
    depends on H3C_IPQ5018_COMMON
    default ""
    help
      Pin this image to one exact entry from h3c_nand_catalog.h. This is
      required when a JEDEC prefix has multiple OEM source variants. Runtime
      geometry and ECC checks still have to match; this setting does not grant
      APPSBL write or installation qualification.

config H3C_NAND_SOURCE_MASK
    hex "Exact OEM source mask for the selected NAND profile"
    depends on H3C_NAND_PROFILE_ID != ""
    default 0x0
    help
      Must be one exact source bit admitted by the selected profile. Zero is
      invalid for a pinned image. This binds ambiguous IDs to source evidence.

config H3C_NAND_LOAD_ECC_BITS
    int "Exact OEM NAND APPSBL load ECC mode"
    depends on H3C_NAND_PROFILE_ID != ""
    range 4 8
    default 4
    help
      Declares the ECC4 or ECC8 format used to load the SBL/APPSBL source.
      It must equal STORAGE_ECC_BITS for this repair path; no conversion is
      performed. Runtime QPIC identity and geometry are still checked.

config H3C_NAND_STORAGE_ECC_BITS
    int "Exact OEM NAND system storage ECC mode"
    depends on H3C_NAND_PROFILE_ID != ""
    range 4 8
    default 4
    help
      Declares the selected source profile's persisted APPSBL page format.
      It must equal LOAD_ECC_BITS; QPIC starts in this format. Runtime NAND
      metadata is still checked before Linux handoff or writes.

config H3C_NAND_AUTO_PROFILE
    bool "Select the NAND profile and boot-chain ECC at run time"
    depends on H3C_IPQ5018_COMMON && H3C_NAND_ECC_COMPAT && H3C_NAND_PROFILE_ID = ""
    default n
    help
      Build one image that serves every catalog NAND chip. A chip with one
      catalog row and one boot-chain ECC mode is taken from the catalog;
      otherwise SBL1, MIBIB and APPSBL pages are read in each candidate
      format and the format must be evidenced uniquely. If it is not, no
      profile is selected, NAND writes stay rejected and the recovery page
      is used. The build identity is profile=auto. Not valid together with
      H3C_NAND_PROFILE_ID.

config H3C_NAND_ACCEPT_AUTO_IMAGE
    bool "Accept auto-profile U-Boot images in the rescue upload"
    depends on H3C_IPQ5018_COMMON
    default y if H3C_NAND_AUTO_PROFILE
    default n
    help
      Let h3c_build_id_check() accept an upload whose build identity is
      profile=auto for the same board. Always on in auto-profile builds; a
      pinned build needs this to accept an auto upload.

config H3C_NAND_ECC_COMPAT
    bool "Evidence-based NAND ECC compatibility"
    depends on H3C_IPQ5018_COMMON
    default y
    help
      Check complete ENV CRC before environment relocation, independently
      sample system UBI metadata, and preserve the proven existing BCH mode.
      Unknown or conflicting formats keep recovery available and reject
      persistent windows and NAND Linux handoff. This does not certify an
      APPSBL/front-stage format or enable NOR operations.

config H3C_BOARD
    bool
    default y if TARGET_IPQ5018_H3C_RT3000_B || TARGET_IPQ5018_H3C_HW_A || TARGET_IPQ5018_H3C_HW_C || TARGET_IPQ5018_H3C_HW_D
    help
      Any H3C NX30-family board. Gates H3C-only build identity, FEM and
      NAND catalog reporting so other IPQ5018 boards still compile.

config H3C_IPQ5018_COMMON
    bool
    default y if TARGET_IPQ5018_H3C_RT3000_B || TARGET_IPQ5018_H3C_HW_A || TARGET_IPQ5018_H3C_HW_C || TARGET_IPQ5018_H3C_HW_D
    help
      Shared validated SMEM layout, dual-slot, metadata and recovery services.

