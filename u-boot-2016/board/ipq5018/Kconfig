    bool
    default y if TARGET_IPQ5018_H3C_HW_A || TARGET_IPQ5018_H3C_HW_C || TARGET_IPQ5018_H3C_HW_D
    help
      BOOTCONFIG copies live at fixed extents and have their own write window.

config H3C_MIBIB_RAM_RELOAD
